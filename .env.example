# GoDaddy auth — owner-only. Never commit real values.
# Preferred (Domains v3 + current v1): Personal Access Token
GODADDY_PAT=

# Legacy fallback for Domains v1 only (sso-key). Scheduled for deprecation in 2026.
GODADDY_API_KEY=
GODADDY_API_SECRET=

GODADDY_API_BASE=https://api.godaddy.com
GODADDY_PRIMARY_DOMAIN=psemanagement.services
GODADDY_ALLOWED_DOMAINS=psemanagement.services
ORGSUITE_MCP_TOKEN=
ALLOW_PUBLIC_HEALTH=true
